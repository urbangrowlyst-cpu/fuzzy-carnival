# Telegram bot credentials.
# Create a bot with @BotFather, then get your chat ID from @userinfobot.
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=PASTE_YOUR_CHAT_ID

# Optional: Google Apps Script Web App URL (it ends with /exec)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# AI review generator (Patasa-style). Keep the key server-only.
AI_API_KEY=PASTE_YOUR_KEY_HERE
AI_MODEL=gemini-3.5-flash-lite
AI_MAX_OUTPUT_TOKENS=150
AI_TIMEOUT_MS=5000
ALLOWED_ORIGIN=
RATE_LIMIT_SALT=replace-with-a-private-random-phrase
